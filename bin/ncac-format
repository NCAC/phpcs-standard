#!/usr/bin/env php
<?php declare(strict_types=1);

/**
 * ncac-format - formats PHP code to the NCAC standard in two passes
 * (PHP-CS-Fixer, then PHPCBF) and validates the result with PHPCS.
 *
 * Run `ncac-format --help` for usage. The implementation lives in
 * NCAC\Cli\Format\FormatCommand.
 */

use NCAC\Cli\Format\Console;
use NCAC\Cli\Format\FormatCommand;
use NCAC\Cli\Format\ProcOpenRunner;

$autoload_candidates = [
  __DIR__ . '/../vendor/autoload.php', // this package is the root project
  __DIR__ . '/../../../autoload.php', // this package is installed as a dependency
];
$autoload_file = null;
foreach ($autoload_candidates as $autoload_candidate) {
  if (is_file($autoload_candidate)) {
    $autoload_file = $autoload_candidate;
    break;
  }
}
if ($autoload_file === null) {
  fwrite(\STDERR, "ncac-format: Composer autoloader not found. Run composer install.\n");
  exit(3);
}
require_once $autoload_file;

// Composer 2.2+ binary proxies expose the configured bin-dir.
$composer_bin_directory = $GLOBALS['_composer_bin_dir'] ?? null;
$bin_directories = \is_string($composer_bin_directory) ? [$composer_bin_directory] : [];

$command = new FormatCommand(\dirname(__DIR__), $bin_directories, new ProcOpenRunner(), Console::forStandardStreams());
exit($command->run(array_values(\array_slice($argv, 1)), (string) getcwd()));
